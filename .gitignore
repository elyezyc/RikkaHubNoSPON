# 构建产物：APK 只发 Releases，不进仓库
/dist/
*.apk
*.idsig

# 第三方二进制：由 tools/fetch_toolchain.sh 下载
/tools/*.jar
/tools/jdk-*/
/tools/jdk*.tar.gz
/tools/android-sdk/
/tools/*.zip

# 构建中间产物
/.work/

# 反编译输出（分析用，可随时重新生成）
/decompiled/
/decompiled_full/

# 宿主源码与官方发布包：体积大，需要时按 README 重新获取
# 注意要锚定到仓库根目录，否则 test/me/rerere/rikkahub/ 这些替身也会被误伤
/rikkahub/
/rikkahub-*.apk

# ===== 私密材料，一律不上传 =====
# Key/ 里有签名密钥库、密钥库口令、SSH 私钥
/Key/
*.jks
*.keystore
id_ed25519*

# 编辑器 / 系统垃圾
.idea/
*.iml
.vscode/
.DS_Store
